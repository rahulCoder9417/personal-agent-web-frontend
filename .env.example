# Copy to .env.local. With nothing set, the app runs in demo mode: an in-memory account, no backend, no sign-in.

# --- Backend ------------------------------------------------------------------------------------
# The Textcrew API (the backend's `api` process). The Next.js server calls it; the browser never does.
TEXTCREW_API_URL=http://localhost:8080

# --- Sign-in (Clerk) ----------------------------------------------------------------------------
# Use the same Clerk application as the backend. Setting both keys turns demo mode off.
# The backend's WEB_APP_URL and CLERK_AUTHORIZED_PARTIES must be this app's address
# (http://localhost:3000 in development, which is also their default).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# --- Local backend without Clerk ----------------------------------------------------------------
# `pnpm backend:local` prints a token for its seeded user. Development only: ignored in a production build.
# TEXTCREW_DEV_TOKEN=

# --- Demo mode ----------------------------------------------------------------------------------
# 1 forces demo mode even when the Clerk keys are set.
# TEXTCREW_DEMO=1
# Seeds the demo account on another plan (free | pro | max), e.g. to see your own MCP servers.
# TEXTCREW_DEMO_PLAN=max
