{
  "name": "textcrew-web",
  "version": "0.1.0",
  "private": true,
  "description": "Textcrew web app: the screens people use in a browser, on a laptop or a phone, and the API proxy behind them",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backend:local": "node scripts/local-backend.mjs",
    "openapi:gen": "openapi-typescript openapi/openapi.yaml -o src/lib/api/schema.d.ts",
    "openapi:sync": "cp ../beckend/openapi/openapi.yaml openapi/openapi.yaml && pnpm openapi:gen"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.9",
    "@dagrejs/dagre": "3.1.1",
    "@tanstack/react-query": "^5.104.0",
    "@xyflow/react": "12.12.0",
    "next": "16.3.8",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.33.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "happy-dom": "^21.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.33.0"
}
